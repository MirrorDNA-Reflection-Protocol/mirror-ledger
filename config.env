# mirror-ledger pipeline configuration. Sourced by scripts/run_weekly.sh.
# Keep values quoted; this file is executed by /bin/bash (macOS 3.2).

# Governed Claude launcher (subscription-backed; NEVER an API-keyed session).
CLAUDE_BIN="/Users/pauldesai/bin/claude"

# Model pin for headless calls — mirrors ~/.mirrordna/policy/model_registry.json
# clients.claude.expected.model. Change deliberately, in step with the registry.
MODEL="claude-opus-4-6"

# 0 = commit locally only (Paul pushes during review). 1 = push after commit
# when an origin remote exists. Public timestamps require pushing; flip to 1
# once the first supervised run looks right.
PUSH_ON_RUN="0"

# Seconds allowed per headless evidence-gathering call before it is abandoned
# for that prediction (the run continues; the prediction just gets no new
# evidence this week).
GATHER_TIMEOUT="600"

# Seconds allowed per evidence-URL fetch during validation.
URL_TIMEOUT="20"

# Optional: force a specific python interpreter (must have the yaml module).
# Leave empty to autodetect (~/.mirrordna/venv/bin/python, then Homebrew,
# then system python3).
PYBIN_OVERRIDE=""
